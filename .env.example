# SimSit AI — Environment Variables
# Copy this file to .env and fill in your values

# Required: Your Groq or OpenAI API Key
OPENAI_API_KEY=your_api_key_here

# Required: Flask secret key (any random string)
FLASK_SECRET_KEY=your-random-secret-key-here

# Optional: Model selection (default: llama3-8b-8192)
# MODEL_NAME=llama3-8b-8192

# Optional: Max tokens per response
# MAX_TOKENS=1024

# Optional: Port (default: 5000)
# PORT=5000
